{
  "name": "my-website",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "node --require ./scripts/limit-file-reads.cjs node_modules/@docusaurus/core/bin/docusaurus.mjs",
    "start": "npm run docusaurus -- start",
    "build": "npm run docusaurus -- build",
    "prebuild": "npm run gen:documents",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "typecheck": "tsc",
    "generate:characters": "tsx scripts/generate-character-pages.ts",
    "generate:factions": "tsx scripts/generateFactionsMdx.ts",
    "generate:docs": "tsx scripts/generate-docs.ts",
    "gen:characters": "tsx scripts/generate-character-pages.ts",
    "gen:characters:dry": "tsx scripts/generate-character-pages.ts --dry-run",
    "gen:characters:force": "tsx scripts/generate-character-pages.ts --force",
    "gen:factions": "tsx scripts/generateFactionsMdx.ts",
    "gen:factions:dry": "tsx scripts/generateFactionsMdx.ts --dry-run",
    "gen:factions:force": "tsx scripts/generateFactionsMdx.ts --force",
    "gen:documents": "tsx scripts/generate-document-pages.ts --clean",
    "migrate:documents:mdx": "tsx scripts/migrate-document-content-to-mdx.ts",
    "test": "tsx --test tests/document-mdx.test.ts tests/character-id-normalization.test.ts tests/fill-null-character-image-paths.test.mjs tests/faction-directory-ordering.test.ts tests/character-faction-ordering.test.ts tests/public-build-policy.test.mjs tests/audit-character-doc-duplicates.test.mjs",
    "test:character-ids": "tsx --test tests/character-id-normalization.test.ts",
    "validate:data": "tsx scripts/validate-data.ts",
    "images:webp": "node scripts/convert-images-to-webp.mjs",
    "images:paths:dry": "node scripts/migrate-image-paths-to-webp.mjs",
    "images:paths:write": "node scripts/migrate-image-paths-to-webp.mjs --write",
    "images:paths:check": "node scripts/migrate-image-paths-to-webp.mjs --check",
    "images:migrate": "npm run images:webp && npm run images:paths:write",
    "test:image-paths": "node --test tests/image-path-migration.test.mjs",
    "images:fill-null-paths:dry": "node scripts/fill-null-character-image-paths.mjs",
    "images:fill-null-paths": "node scripts/fill-null-character-image-paths.mjs --write",
    "images:fill-null-paths:check": "node scripts/fill-null-character-image-paths.mjs --check",
    "test:fill-null-paths": "node --test tests/fill-null-character-image-paths.test.mjs",
    "build:public": "node scripts/build-public.mjs",
    "test:public-build": "node --test tests/public-build-policy.test.mjs",
    "test:faction-prefix": "node --test tests/character-faction-prefix.test.mjs",
    "audit:character-docs": "node scripts/audit-character-doc-duplicates.mjs",
    "cleanup:character-docs:safe": "node scripts/audit-character-doc-duplicates.mjs --write --confirm-safe-only"
  },
  "dependencies": {
    "@docusaurus/core": "3.9.2",
    "@docusaurus/plugin-client-redirects": "^3.9.2",
    "@docusaurus/preset-classic": "3.9.2",
    "@easyops-cn/docusaurus-search-local": "^0.55.0",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.0.0",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.8.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.9.2",
    "@docusaurus/tsconfig": "3.9.2",
    "@docusaurus/types": "3.9.2",
    "sharp": "^0.35.4",
    "tsx": "^4.21.0",
    "typescript": "~5.6.2"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=20.0"
  }
}
